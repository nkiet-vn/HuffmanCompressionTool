#include <winver.h>
1 ICON "type-sort.ico"
VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "CompanyName", "Type Foundry"
   VALUE "FileDescription", "The Type Foundry - Huffman Compression Tool"
   VALUE "FileVersion", "1.0.0.0"
   VALUE "ProductName", "The Type Foundry"
   VALUE "ProductVersion", "1.0.0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
